PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/carvanholidays
CLIENT_ORIGIN=http://localhost:5173

# Admin login (single admin). Either set ADMIN_PASSWORD (hashed at startup)
# or precompute a bcrypt hash and set ADMIN_PASSWORD_HASH instead.
ADMIN_EMAIL=admin@carvanholidays.local
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=$2a$10$...

# Used to sign admin JWTs — change in production.
JWT_SECRET=dev-secret-change-me
